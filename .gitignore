# RuralCare AI Workspace gitignore

# Python virtual environment
backend/venv/
backend/__pycache__/
backend/app/__pycache__/
backend/app/api/__pycache__/
backend/app/ai/__pycache__/
backend/app/config/__pycache__/
backend/app/database/__pycache__/
backend/app/models/__pycache__/
backend/app/services/__pycache__/
backend/app/speech/__pycache__/
backend/tests/__pycache__/
*.pyc

# Local Environment secrets (must NOT be committed)
backend/.env
frontend/.env
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Frontend dependency & build outputs
frontend/node_modules/
frontend/dist/
frontend/out/
frontend/.oxlintrc.json

# Local database caches
database/.data/
database/backup/

# Logs and runtime artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache

# Config templates (explicitly tracking example templates)
!.env.example
!backend/.env.example
!frontend/.env.example

# IDE settings
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
